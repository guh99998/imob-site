# Copie para .env na VPS (nunca commitar o .env). Usado pelo docker-compose.yml.
DOMAIN=imobiliaria.example.com.br
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=imobiliaria.example.com.br
CSRF_TRUSTED_ORIGINS=https://imobiliaria.example.com.br
DJANGO_SETTINGS_MODULE=imob_site.settings.prod

# Módulos opcionais e destaques
# FEATURES=brokers,partners,owners,searches,crm,api
# MAX_FEATURED=3

# E-mail (avisos de novos contatos)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Fotos em S3 compatível (opcional; sem isso ficam no volume "media")
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
